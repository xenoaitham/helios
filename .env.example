# HELIOS platform configuration — LOCAL DEV DEFAULTS.
# Copy to .env (`make env` does it for you) and adjust for your machine.
# .env is gitignored: NEVER commit real secrets.

# --- Postgres OLTP (source system, seeded in Phase 1) ---
OLTP_POSTGRES_USER=oltp
OLTP_POSTGRES_PASSWORD=oltp_local_dev
OLTP_POSTGRES_DB=oltp
OLTP_PORT=5432

# --- Postgres Warehouse (raw / staging / marts schemas) ---
WAREHOUSE_POSTGRES_USER=warehouse
WAREHOUSE_POSTGRES_PASSWORD=warehouse_local_dev
WAREHOUSE_POSTGRES_DB=warehouse
WAREHOUSE_PORT=5433

# --- Airflow (2.10.x, LocalExecutor) ---
AIRFLOW_UID=50000
AIRFLOW_WWW_USER=airflow
AIRFLOW_WWW_PASSWORD=airflow_local_dev
AIRFLOW_PORT=8080
# Infra-only metadata DB (not a data store; not part of the "Postgres x2" story)
AIRFLOW_DB_PASSWORD=airflow_local_dev
# Must be identical across webserver/scheduler; change for anything beyond local dev
AIRFLOW_SECRET_KEY=helios-local-dev-secret

# --- Kafka (KRaft, single combined broker+controller) ---
KAFKA_PORT=9092
KAFKA_HOST_PORT=29092

# --- SOAP OrderManagement (legacy source, Phase 1; ADR-001) ---
SOAP_PORT=8000
SOAP_BASIC_AUTH_USER=soap_local_dev
SOAP_BASIC_AUTH_PASSWORD=soap_local_dev


# --- OLTP seeder / mutator (Phase 1 source; ADR-002) ---
OLTP_SEED_USERS=50000
OLTP_SEED_ORDERS=500000
OLTP_MUTATE_TICK_SECONDS=2

# --- REST mock: Pricing & Promotions API (Phase 1; ADR-003) ---
REST_MOCK_PORT=8001
REST_MOCK_FLAKE_PERCENT=5
REST_MOCK_FLAKE_SEED=42
REST_MOCK_RATE_CAPACITY=30
REST_MOCK_RATE_REFILL_PER_SEC=10

# --- CDC: Debezium + raw-zone sink (Phase 2; ADR-005) ---
# Replication role created on oltp-db by `make cdc-setup` (lowercase alnum/underscore).
CDC_DB_USER=helios_cdc
CDC_DB_PASSWORD=cdc_local_dev
# Kafka Connect REST (localhost:8083 is also the control-plane port).
CDC_CONNECT_PORT=8083
# JVM heap for the Connect worker (peak RSS ~2x this during snapshot).
KAFKA_CONNECT_HEAP_OPTS="-Xms256M -Xmx768M"
